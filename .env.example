# Set both private values before starting. See docs/GAMES_MANUAL.md.
NODE_ENV=development
HOST_PASSWORD=
SESSION_SECRET=
PORT=3000
DATA_FILE=.data/game.json

# Optional for local development; leave commented to use .data/game.json.
# Uncomment and adjust only if using a local PostgreSQL database.
# DATABASE_URL=postgresql://localhost:5432/resort_games
DATABASE_SSL=false

# Optional canonical HTTPS origin used when generating QR links.
PUBLIC_BASE_URL=

# Optional: enable Get The Picture and Screengrabbers uploads in the PRIVATE games R2 bucket.
# Games use separate prefixes in this bucket; no extra bucket is needed.
# Leave all four blank for Get The Picture starter images only (Screengrabbers needs uploads).
# Enter secrets locally or in Render Environment, never in source control or chat.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
